# Copy to a private path (never commit real secrets).
# Replace the three REQUIRED lines with factory / staging values, then:
#   set -a && source /path/to/moishome.env && set +a
#   cd source/pcv84x6_llm_server && PYTHONPATH=. python3 -m app.moishome.cli smoke
#
# MOISHOME_BASE_URL = platform root WITHOUT /api/v1 (client appends it).

# --- REQUIRED for live smoke (replace placeholders) ---
MOISHOME_BASE_URL=https://open-platform.example.com
MOISHOME_SERIAL=SN-FACTORY-001
MOISHOME_TEMP_KEY=replace-with-temp-key-ge16

# --- OPTIONAL ---
MOISHOME_SKU=64G
MOISHOME_MODEL=CV84X6
MOISHOME_FIRMWARE=0.6.37
# MOISHOME_HTTP_TIMEOUT_S=15
# MOISHOME_CREDENTIALS_PATH=/tmp/moishome_device.json
# MOISHOME_HEARTBEAT=1
# MOISHOME_HEARTBEAT_INTERVAL_S=60

# Platform-side only (not read by the device client):
#   CATALOG_ENTITLEMENT_GATE=0
# Temporarily opens GET /device-api/catalog when the device has no customer entitlement.

# Offline proof without secrets:
#   PYTHONPATH=. python3 scripts/moishome_smoke_mock.py
