# MoisHome open-platform device-api fixtures (placeholder — not real secrets).
# Copy to a private env file for live smoke; unit tests use MockTransport + JSON fixtures.

MOISHOME_BASE_URL=https://platform.example.invalid
MOISHOME_SERIAL=SN-ZETAO-FIXTURE-001
# tempKey must be ≥16 chars per contract
MOISHOME_TEMP_KEY=fixture-temp-key-16
MOISHOME_FIRMWARE=0.6.37
MOISHOME_CONFIG_VERSION=0
MOISHOME_SKU=64G
MOISHOME_HTTP_TIMEOUT_S=15

# Platform-side only (set on moishome-open-platform API process, not the board):
# CATALOG_ENTITLEMENT_GATE=0
# Use when the device is activated but not yet customer-bound and you still need
# GET /api/v1/device-api/catalog during bring-up. Default on the platform is fail-closed.
